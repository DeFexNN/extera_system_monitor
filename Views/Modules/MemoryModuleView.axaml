<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:ExteraMonitor.ViewModels.Modules" x:Class="ExteraMonitor.Views.Modules.MemoryModuleView" x:DataType="vm:MemoryModuleViewModel"><ScrollViewer><StackPanel Margin="42,34,42,42" Spacing="24"><StackPanel Spacing="6"><TextBlock Text="Memory" FontSize="31" FontWeight="SemiBold"/><TextBlock Text="Physical memory pressure and application working sets." Classes="muted" FontSize="14"/></StackPanel><Grid ColumnDefinitions="1.25*,*" ColumnSpacing="18"><Border Classes="panel"><StackPanel Spacing="22"><TextBlock Text="MEMORY IN USE" Classes="eyebrow"/><TextBlock Text="{Binding Used}" FontSize="64" FontWeight="SemiBold"/><TextBlock Text="{Binding Total}" Classes="muted"/><ProgressBar Value="{Binding Usage}" Maximum="100" Height="14"/><Grid ColumnDefinitions="*,*,*"><StackPanel><TextBlock Text="USAGE" Classes="eyebrow"/><TextBlock Text="{Binding Usage, StringFormat={}{0:0.0}%}" FontSize="21"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="AVAILABLE" Classes="eyebrow"/><TextBlock Text="{Binding Available}" FontSize="21"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="TOTAL" Classes="eyebrow"/><TextBlock Text="{Binding Total}" FontSize="21"/></StackPanel></Grid></StackPanel></Border><Border Classes="card" Grid.Column="1"><StackPanel Spacing="18"><TextBlock Text="MEMORY STATUS" Classes="eyebrow"/><TextBlock Text="HEALTHY" FontSize="29" FontWeight="SemiBold" Foreground="#395B64"/><TextBlock Text="No paging pressure is currently detected." Classes="muted" TextWrapping="Wrap"/><TextBlock Text="Swap activity: idle" Classes="muted" FontSize="12"/></StackPanel></Border></Grid><Border Classes="panel"><StackPanel Spacing="14"><TextBlock Text="MEMORY PRESSURE" FontSize="19" FontWeight="SemiBold"/><Grid ColumnDefinitions="*,Auto"><TextBlock Text="In use"/><TextBlock Grid.Column="1" Text="{Binding Used}"/></Grid><ProgressBar Value="{Binding Usage}" Maximum="100"/><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Available"/><TextBlock Grid.Column="1" Text="{Binding Available}"/></Grid><TextBlock Text="Values are sampled from Windows physical memory status." Classes="muted" FontSize="12"/></StackPanel></Border></StackPanel></ScrollViewer></UserControl>
