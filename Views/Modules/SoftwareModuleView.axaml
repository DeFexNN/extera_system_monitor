<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:ExteraMonitor.ViewModels.Modules" x:Class="ExteraMonitor.Views.Modules.SoftwareModuleView" x:DataType="vm:SoftwareModuleViewModel"><ScrollViewer><StackPanel Margin="42,34,42,42" Spacing="24"><StackPanel Spacing="6"><TextBlock Text="Software" FontSize="31" FontWeight="SemiBold"/><TextBlock Text="A reserved workspace for future system and application tooling." Classes="muted" FontSize="14"/></StackPanel><Border Classes="card"><StackPanel Spacing="8"><TextBlock Text="FUTURE MODULES" Classes="eyebrow"/><TextBlock Text="The monitoring core is ready; this page keeps future feature work isolated from the live telemetry pipeline." TextWrapping="Wrap"/></StackPanel></Border><ItemsControl ItemsSource="{Binding Features}"><ItemsControl.ItemTemplate><DataTemplate><Border Classes="panel" Margin="0,0,0,14"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="6"><TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Classes="muted"/></StackPanel><Border Grid.Column="1" Background="#A5C9CA" CornerRadius="10" Padding="11,6" VerticalAlignment="Center"><TextBlock Text="{Binding Status}" Foreground="#2C3333" FontSize="11" FontWeight="SemiBold"/></Border></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></UserControl>
