<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ExteraMonitor.ViewModels.Modules"
             xmlns:controls="using:ExteraMonitor.Views.Controls"
             x:Class="ExteraMonitor.Views.Modules.SettingsModuleView"
             x:DataType="vm:SettingsModuleViewModel">
  <ScrollViewer>
    <StackPanel Margin="42,34,42,42" Spacing="24">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
        <StackPanel Spacing="6">
          <TextBlock Text="Settings" FontSize="31" FontWeight="SemiBold"/>
          <TextBlock Text="Configure ExteraMonitor's four global theme colors." Classes="muted" FontSize="14"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="THEME" Classes="eyebrow" VerticalAlignment="Center"/>
          <ComboBox Width="120" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"/>
          <Button Classes="module-action" Content="RESET THEME" Command="{Binding ResetCommand}"/>
        </StackPanel>
      </Grid>

      <Border Classes="panel">
        <StackPanel Spacing="18">
          <TextBlock Text="GLOBAL THEME PALETTE" Classes="eyebrow"/>
          <TextBlock Text="These four colors control the application window, chrome, buttons, borders and secondary highlights. Changes apply immediately and persist locally." Classes="muted" FontSize="12" TextWrapping="Wrap"/>
          <ItemsControl ItemsSource="{Binding Colors}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                    <Grid ColumnDefinitions="280,*,Auto,Auto" ColumnSpacing="12" Margin="0,0,0,10" MinHeight="42">
                  <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="22" Height="22" CornerRadius="11" Background="{Binding SwatchBrush}" BorderBrush="{DynamicResource ThemeSoftBrush}" BorderThickness="1"/>
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Description}" Classes="muted" FontSize="10" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </StackPanel>
                  <TextBox Grid.Column="1" Text="{Binding HexText}" PlaceholderText="#RRGGBB" VerticalContentAlignment="Center"/>
                  <controls:ManualColorPicker Grid.Column="2" SelectedColor="{Binding SelectedColor, Mode=TwoWay}" ColorApplied="ThemeColorApplied" VerticalAlignment="Center"/>
                  <Button Grid.Column="3" Classes="module-action" Content="APPLY" Command="{Binding ApplyCommand}" Padding="16,8"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Classes="panel">
        <StackPanel Spacing="12">
          <StackPanel Spacing="4">
            <TextBlock Text="LIVE THEME PREVIEW" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="This sample uses the same four application resources as the window, navigation, cards and controls." Classes="muted" FontSize="12" TextWrapping="Wrap"/>
          </StackPanel>
          <Border Background="{DynamicResource ThemeChromeBrush}" CornerRadius="13" Padding="14">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="8">
                <TextBlock Text="EXTERA MONITOR" Foreground="{DynamicResource ThemeChromeTextBrush}" FontSize="13" FontWeight="Bold" LetterSpacing="1.2"/>
                <Border Background="{DynamicResource ThemeWindowBrush}" CornerRadius="9" Padding="12">
                  <StackPanel Spacing="7">
                    <TextBlock Text="Window surface" Foreground="{DynamicResource ThemeTextBrush}" FontWeight="SemiBold"/>
                    <TextBlock Text="Secondary text and progress tracks" Foreground="{DynamicResource ThemeAccentBrush}" FontSize="11"/>
                    <ProgressBar Value="68" Maximum="100"/>
                  </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                <Button Classes="module-action" Content="ACCENT BUTTON"/>
                <Border Height="24" CornerRadius="8" Background="{DynamicResource ThemeSoftBrush}"/>
                <Border Height="24" CornerRadius="8" Background="{DynamicResource ThemeAccentBrush}"/>
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
