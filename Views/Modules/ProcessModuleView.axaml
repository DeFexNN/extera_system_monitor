<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:ExteraMonitor.ViewModels.Modules" x:Class="ExteraMonitor.Views.Modules.ProcessModuleView" x:DataType="vm:ProcessModuleViewModel"><ScrollViewer><StackPanel Margin="42,34,42,42" Spacing="24"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="6"><TextBlock Text="Processes" FontSize="31" FontWeight="SemiBold"/><TextBlock Text="Most active local processes in the current session." Classes="muted" FontSize="14"/></StackPanel><Border Grid.Column="1" Background="#E7F6F2" CornerRadius="14" Padding="16,10" VerticalAlignment="Center"><StackPanel><TextBlock Text="{Binding Count, StringFormat={}{0} active}" FontWeight="SemiBold"/><TextBlock Text="processes detected" Classes="muted" FontSize="11"/></StackPanel></Border></Grid><Border Classes="panel"><Grid RowDefinitions="Auto,*"><Grid ColumnDefinitions="2*,*,*,*" Margin="0,0,0,12"><TextBlock Text="PROCESS" Classes="eyebrow"/><TextBlock Grid.Column="1" Text="USER" Classes="eyebrow"/><TextBlock Grid.Column="2" Text="CPU" Classes="eyebrow"/><TextBlock Grid.Column="3" Text="MEMORY" Classes="eyebrow"/></Grid><ItemsControl Grid.Row="1" ItemsSource="{Binding Items}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#A5C9CA" BorderThickness="0,1,0,0" Padding="0,13"><Grid ColumnDefinitions="2*,*,*,*"><StackPanel><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}" Classes="muted" FontSize="11"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding User}" VerticalAlignment="Center" Classes="muted"/><TextBlock Grid.Column="2" Text="{Binding Cpu, StringFormat={}{0:0.0}%}" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{Binding Memory, StringFormat={}{0:0.0} MB}" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></Border></StackPanel></ScrollViewer></UserControl>
