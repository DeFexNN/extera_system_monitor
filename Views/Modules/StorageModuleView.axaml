<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ExteraMonitor.ViewModels.Modules"
             x:Class="ExteraMonitor.Views.Modules.StorageModuleView"
             x:CompileBindings="False">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24,22,24,28" Spacing="16">
      <StackPanel Spacing="4">
        <TextBlock Text="Storage" FontSize="30" FontWeight="SemiBold"/>
        <TextBlock Text="Capacity and utilization for ready local volumes exposed by Windows." Classes="muted" FontSize="13" TextWrapping="Wrap"/>
      </StackPanel>

      <WrapPanel Orientation="Horizontal">
        <Border Classes="panel" Width="280" MinHeight="206" Margin="0,0,12,12">
          <StackPanel Spacing="12">
            <TextBlock Text="PRIMARY VOLUME" Classes="eyebrow"/>
            <TextBlock Text="{Binding PrimaryName}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Used}" FontSize="38" FontWeight="SemiBold"/>
            <ProgressBar Value="{Binding Usage}" Maximum="100" Height="12" IsVisible="{Binding HasData}"/>
            <TextBlock Text="{Binding Total}" Classes="muted" FontSize="11"/>
          </StackPanel>
        </Border>
        <Border Classes="telemetry-card" Width="210" MinHeight="206" Padding="18" Margin="0,0,12,12">
          <StackPanel Spacing="8" VerticalAlignment="Center"><TextBlock Text="ALL SAMPLED VOLUMES" Classes="eyebrow"/><TextBlock Text="{Binding AllVolumesSummary}" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Used / total capacity summed across listed volumes" Classes="muted" FontSize="11" TextWrapping="Wrap"/></StackPanel>
        </Border>
        <Border Classes="telemetry-card" Width="190" MinHeight="206" Padding="18" Margin="0,0,12,12">
          <StackPanel Spacing="8" VerticalAlignment="Center"><TextBlock Text="READY VOLUMES" Classes="eyebrow"/><TextBlock Text="{Binding DiskCount}" FontSize="32" FontWeight="SemiBold"/><TextBlock Text="{Binding CapacitySummary}" Classes="muted" FontSize="11" TextWrapping="Wrap"/></StackPanel>
        </Border>
      </WrapPanel>

      <Border Classes="panel">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <StackPanel Spacing="3"><TextBlock Text="DETECTED VOLUMES" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="The sampler lists up to three ready fixed or removable volumes." Classes="muted" FontSize="11" TextWrapping="Wrap"/></StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding DiskCount, StringFormat={}{0} / 3}" Classes="eyebrow" VerticalAlignment="Center"/>
          </Grid>
          <ItemsControl ItemsSource="{Binding Disks}" IsVisible="{Binding HasDisks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource ThemeSoftBrush}" BorderThickness="0,1,0,0" Padding="10,12">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                      <StackPanel Spacing="2"><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding VolumeLabel}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel>
                      <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right"><TextBlock Text="{Binding UsedGigabytes, StringFormat={}{0:0.0} GB used}" FontWeight="SemiBold"/><TextBlock Text="{Binding TotalGigabytes, StringFormat={}{0:0.0} GB total}" Classes="muted" FontSize="11" HorizontalAlignment="Right"/></StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                      <ProgressBar Value="{Binding UsagePercent}" Maximum="100" Height="9" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="{Binding UsagePercent, StringFormat={}{0:0.0}% used}" FontSize="11"/>
                    </Grid>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border IsVisible="{Binding HasNoDisks}" Background="{DynamicResource ThemeSoftBrush}" CornerRadius="10" Padding="16">
            <StackPanel Spacing="5"><TextBlock Text="NO READY VOLUME" Classes="eyebrow"/><TextBlock Text="No fixed or removable volume is currently available to the sampler. Values are shown as N/A instead of zero." Classes="muted" FontSize="12" TextWrapping="Wrap"/></StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
