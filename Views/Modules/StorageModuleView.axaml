<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:ExteraMonitor.ViewModels.Modules" x:Class="ExteraMonitor.Views.Modules.StorageModuleView" x:DataType="vm:StorageModuleViewModel"><ScrollViewer><StackPanel Margin="42,34,42,42" Spacing="24"><StackPanel Spacing="6"><TextBlock Text="Storage" FontSize="31" FontWeight="SemiBold"/><TextBlock Text="Up to three ready local disks are detected automatically." Classes="muted" FontSize="14"/></StackPanel><Grid ColumnDefinitions="1.3*,*" ColumnSpacing="18"><Border Classes="panel"><StackPanel Spacing="22"><TextBlock Text="{Binding PrimaryName}" Classes="eyebrow"/><TextBlock Text="{Binding Used}" FontSize="64" FontWeight="SemiBold"/><TextBlock Text="{Binding Total}" Classes="muted"/><ProgressBar Value="{Binding Usage}" Maximum="100" Height="14"/><TextBlock Text="Capacity used on the first detected volume." Classes="muted" FontSize="12"/></StackPanel></Border><Border Classes="card" Grid.Column="1"><StackPanel Spacing="18"><TextBlock Text="DISK DISCOVERY" Classes="eyebrow"/><TextBlock Text="{Binding Disks.Count, StringFormat={}{0} READY}" FontSize="29" FontWeight="SemiBold" Foreground="#395B64"/><TextBlock Text="Fixed and removable disks are sampled without elevated privileges." Classes="muted" TextWrapping="Wrap"/><TextBlock Text="Maximum displayed: 3 drives" Classes="muted" FontSize="12"/></StackPanel></Border></Grid><Border Classes="panel"><StackPanel Spacing="14"><TextBlock Text="DETECTED VOLUMES" FontSize="19" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding Disks}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#A5C9CA" BorderThickness="0,1,0,0" Padding="0,14"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="5"><Grid ColumnDefinitions="Auto,*"><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding VolumeLabel}" Classes="muted" Margin="10,2,0,0"/></Grid><ProgressBar Value="{Binding UsagePercent}" Maximum="100" Height="9"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="{Binding UsedGigabytes, StringFormat={}{0:0.0} GB}" FontWeight="SemiBold"/><TextBlock Text="{Binding TotalGigabytes, StringFormat={}{0:0.0} GB total}" Classes="muted" FontSize="11" HorizontalAlignment="Right"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></StackPanel></ScrollViewer></UserControl>
