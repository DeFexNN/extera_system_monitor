<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:ExteraMonitor.ViewModels.Modules" x:Class="ExteraMonitor.Views.Modules.OverviewModuleView" x:DataType="vm:OverviewModuleViewModel"><ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="42,34,42,42" Spacing="26"><StackPanel Spacing="6"><TextBlock Text="System overview" FontSize="31" FontWeight="SemiBold"/><TextBlock Text="A calm view of every resource running underneath." Classes="muted" FontSize="14"/></StackPanel><Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="14"><Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="CPU LOAD" Classes="eyebrow"/><TextBlock Text="{Binding Cpu, StringFormat={}{0:0}%}" Classes="value"/><ProgressBar Value="{Binding Cpu}" Maximum="100"/><TextBlock Text="{Binding Cores}" Classes="muted" FontSize="12"/></StackPanel></Border><Border Classes="card" Grid.Column="1"><StackPanel Spacing="12"><TextBlock Text="MEMORY" Classes="eyebrow"/><TextBlock Text="{Binding Memory, StringFormat={}{0:0}%}" Classes="value"/><ProgressBar Value="{Binding Memory}" Maximum="100"/><TextBlock Text="System working set" Classes="muted" FontSize="12"/></StackPanel></Border><Border Classes="card" Grid.Column="2"><StackPanel Spacing="12"><TextBlock Text="STORAGE" Classes="eyebrow"/><TextBlock Text="{Binding Storage, StringFormat={}{0:0}%}" Classes="value"/><ProgressBar Value="{Binding Storage}" Maximum="100"/><TextBlock Text="Primary NVMe volume" Classes="muted" FontSize="12"/></StackPanel></Border><Border Classes="card" Grid.Column="3"><StackPanel Spacing="12"><TextBlock Text="UPTIME" Classes="eyebrow"/><TextBlock Text="{Binding Uptime}" Classes="value"/><TextBlock Text="Stable session" Classes="muted" FontSize="12" Margin="0,17,0,0"/></StackPanel></Border></Grid><Border Classes="panel"><Grid RowDefinitions="Auto,Auto,*"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="SYSTEM PULSE" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Live resource balance" Classes="muted" FontSize="12" Margin="0,4,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="LAST 60 SECONDS" Classes="eyebrow"/></Grid><Grid Grid.Row="1" Height="180" Margin="0,26,0,20"><Path Fill="#A5C9CA" Stretch="Fill" Data="M 0,120 C 50,110 60,42 110,85 S 170,150 220,55 S 290,93 340,36 S 410,100 460,40 S 530,90 580,35 S 650,110 700,25"/><Polyline Points="0,120 50,110 110,85 170,150 220,55 290,93 340,36 410,100 460,40 530,90 580,35 650,110 700,25" Stroke="#395B64" StrokeThickness="3" Stretch="Fill"/></Grid><Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="24"><StackPanel><TextBlock Text="CPU" Classes="eyebrow"/><TextBlock Text="{Binding Cpu, StringFormat={}{0:0.0}%}" FontSize="21"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="NETWORK" Classes="eyebrow"/><TextBlock Text="{Binding Network, StringFormat={}{0:0.0} Mbps}" FontSize="21"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="UPTIME" Classes="eyebrow"/><TextBlock Text="{Binding Uptime}" FontSize="21"/></StackPanel></Grid></Grid></Border></StackPanel></ScrollViewer></UserControl>
