<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ExteraMonitor.ViewModels.Modules"
             xmlns:controls="using:ExteraMonitor.Views.Controls"
             x:Class="ExteraMonitor.Views.Modules.OverviewModuleView"
             x:CompileBindings="False">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24,22,24,28" Spacing="16">
      <StackPanel Spacing="4">
        <TextBlock Text="System overview" FontSize="30" FontWeight="SemiBold"/>
        <TextBlock Text="A live snapshot of the resources Extera Monitor currently samples." Classes="muted" FontSize="13" TextWrapping="Wrap"/>
      </StackPanel>

      <WrapPanel Orientation="Horizontal">
        <Border Classes="telemetry-card" Width="226" MinHeight="144" Padding="16" Margin="0,0,10,10">
          <StackPanel Spacing="7"><TextBlock Text="PROCESSOR" Classes="eyebrow"/><TextBlock Text="{Binding Cpu, StringFormat={}{0:0.0}%}" Classes="value" FontSize="32"/><ProgressBar Value="{Binding Cpu}" Maximum="100"/><TextBlock Text="{Binding Cores}" Classes="muted" FontSize="11"/></StackPanel>
        </Border>
        <Border Classes="telemetry-card" Width="226" MinHeight="144" Padding="16" Margin="0,0,10,10">
          <StackPanel Spacing="7"><TextBlock Text="CPU PACKAGE" Classes="eyebrow"/><TextBlock Text="{Binding CpuTemperature}" Classes="value" FontSize="32"/><TextBlock Text="Thermal channel from the active sensor source" Classes="muted" FontSize="11" TextWrapping="Wrap"/></StackPanel>
        </Border>
        <Border Classes="telemetry-card" Width="226" MinHeight="144" Padding="16" Margin="0,0,10,10">
          <StackPanel Spacing="7"><TextBlock Text="PHYSICAL MEMORY" Classes="eyebrow"/><TextBlock Text="{Binding MemoryLabel}" Classes="value" FontSize="32"/><ProgressBar Value="{Binding Memory}" Maximum="100" IsVisible="{Binding HasMemoryData}"/><TextBlock Text="{Binding MemoryDetail}" Classes="muted" FontSize="11"/></StackPanel>
        </Border>
        <Border Classes="telemetry-card" Width="226" MinHeight="144" Padding="16" Margin="0,0,10,10">
          <StackPanel Spacing="7"><TextBlock Text="PRIMARY VOLUME" Classes="eyebrow"/><TextBlock Text="{Binding StorageUsed}" Classes="value" FontSize="28"/><ProgressBar Value="{Binding Storage}" Maximum="100" IsVisible="{Binding HasStorageData}"/><TextBlock Text="{Binding PrimaryVolume}" Classes="muted" FontSize="11" TextWrapping="Wrap"/></StackPanel>
        </Border>
        <Border Classes="telemetry-card" Width="226" MinHeight="144" Padding="16" Margin="0,0,10,10">
          <StackPanel Spacing="7"><TextBlock Text="NETWORK THROUGHPUT" Classes="eyebrow"/><TextBlock Text="{Binding NetworkSummary}" Classes="value" FontSize="20" TextWrapping="Wrap"/><TextBlock Text="Aggregate active-interface counters" Classes="muted" FontSize="11" TextWrapping="Wrap"/></StackPanel>
        </Border>
      </WrapPanel>

      <Border Classes="panel">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <StackPanel Spacing="3"><TextBlock Text="RESOURCE HISTORY" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Last 30 samples · about one minute at the requested refresh cadence" Classes="muted" FontSize="11" TextWrapping="Wrap"/></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="5"><Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource ThemeAccentBrush}"/><TextBlock Text="CPU" Classes="muted" FontSize="10"/></StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="5"><Border Width="8" Height="8" CornerRadius="4" Background="#D86B24"/><TextBlock Text="MEMORY" Classes="muted" FontSize="10"/></StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="5"><Border Width="8" Height="8" CornerRadius="4" Background="#7353C6"/><TextBlock Text="DISK" Classes="muted" FontSize="10"/></StackPanel>
            </StackPanel>
          </Grid>
          <Grid Height="220" ClipToBounds="True">
            <controls:TelemetryGraph Values="{Binding CpuHistory}" Stroke="{DynamicResource ThemeAccentBrush}" Minimum="0" Maximum="100"/>
            <controls:TelemetryGraph Values="{Binding MemoryHistory}" Stroke="#D86B24" Minimum="0" Maximum="100" ShowGrid="False" IsVisible="{Binding HasMemoryData}"/>
            <controls:TelemetryGraph Values="{Binding StorageHistory}" Stroke="#7353C6" Minimum="0" Maximum="100" ShowGrid="False" IsVisible="{Binding HasStorageData}"/>
          </Grid>
        </StackPanel>
      </Border>

      <WrapPanel Orientation="Horizontal">
        <Border Classes="panel" Width="226" Padding="15" Margin="0,0,10,10"><StackPanel Spacing="4"><TextBlock Text="SESSION UPTIME" Classes="eyebrow"/><TextBlock Text="{Binding Uptime}" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border>
        <Border Classes="panel" Width="226" Padding="15" Margin="0,0,10,10"><StackPanel Spacing="4"><TextBlock Text="PROCESSES" Classes="eyebrow"/><TextBlock Text="{Binding ProcessCount}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="system-wide count" Classes="muted" FontSize="10"/></StackPanel></Border>
        <Border Classes="panel" Width="226" Padding="15" Margin="0,0,10,10"><StackPanel Spacing="4"><TextBlock Text="EXPOSED SENSORS" Classes="eyebrow"/><TextBlock Text="{Binding SensorCount}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="currently reported readings" Classes="muted" FontSize="10"/></StackPanel></Border>
        <Border Classes="panel" Width="226" Padding="15" Margin="0,0,10,10"><StackPanel Spacing="4"><TextBlock Text="RAM CAPACITY" Classes="eyebrow"/><TextBlock Text="{Binding MemoryCapacityLabel}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="physical memory" Classes="muted" FontSize="10"/></StackPanel></Border>
      </WrapPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
