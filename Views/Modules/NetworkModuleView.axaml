<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:ExteraMonitor.ViewModels.Modules" x:Class="ExteraMonitor.Views.Modules.NetworkModuleView" x:DataType="vm:NetworkModuleViewModel"><ScrollViewer><StackPanel Margin="42,34,42,42" Spacing="24"><StackPanel Spacing="6"><TextBlock Text="Network" FontSize="31" FontWeight="SemiBold"/><TextBlock Text="Current throughput and local link status." Classes="muted" FontSize="14"/></StackPanel><Grid ColumnDefinitions="*,*" ColumnSpacing="18"><Border Classes="panel"><StackPanel Spacing="18"><TextBlock Text="DOWNLOAD" Classes="eyebrow"/><TextBlock Text="{Binding Download, StringFormat={}{0:0.0} Mbps}" FontSize="42" FontWeight="SemiBold"/><TextBlock Text="Inbound traffic / active link" Classes="muted"/><ProgressBar Value="{Binding Download}" Maximum="120" Height="12"/></StackPanel></Border><Border Classes="panel" Grid.Column="1"><StackPanel Spacing="18"><TextBlock Text="UPLOAD" Classes="eyebrow"/><TextBlock Text="{Binding Upload, StringFormat={}{0:0.0} Mbps}" FontSize="42" FontWeight="SemiBold"/><TextBlock Text="Outbound traffic / active link" Classes="muted"/><ProgressBar Value="{Binding Upload}" Maximum="120" Height="12"/></StackPanel></Border></Grid><Grid ColumnDefinitions="1.25*,*" ColumnSpacing="18"><Border Classes="panel"><StackPanel Spacing="16"><TextBlock Text="LINK ACTIVITY" FontSize="19" FontWeight="SemiBold"/><Grid Height="190"><Path Fill="#A5C9CA" Stretch="Fill" Data="M 0,140 C 60,130 80,50 130,100 S 210,150 260,65 S 340,125 400,44 S 480,110 540,40 S 620,130 700,28"/><Polyline Points="0,140 60,130 130,100 210,150 260,65 340,125 400,44 480,110 540,40 620,130 700,28" Stroke="#395B64" StrokeThickness="3" Stretch="Fill"/></Grid><TextBlock Text="Traffic sampled at two-second intervals." Classes="muted" FontSize="12"/></StackPanel></Border><Border Classes="card" Grid.Column="1"><StackPanel Spacing="18"><TextBlock Text="CONNECTION" Classes="eyebrow"/><TextBlock Text="CONNECTED" FontSize="25" FontWeight="SemiBold" Foreground="#395B64"/><TextBlock Text="Ethernet • 1 Gbps"/><TextBlock Text="Latency 14 ms\nPacket loss 0%" Classes="muted" LineHeight="22"/></StackPanel></Border></Grid></StackPanel></ScrollViewer></UserControl>
