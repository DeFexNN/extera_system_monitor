<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ExteraMonitor.ViewModels.Modules"
             xmlns:controls="using:ExteraMonitor.Views.Controls"
             x:Class="ExteraMonitor.Views.Modules.NetworkModuleView"
             x:CompileBindings="False">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24,22,24,28" Spacing="16">
      <StackPanel Spacing="4">
        <TextBlock Text="Network" FontSize="30" FontWeight="SemiBold"/>
        <TextBlock Text="Live throughput from Windows interface byte counters." Classes="muted" FontSize="13" TextWrapping="Wrap"/>
      </StackPanel>

      <WrapPanel Orientation="Horizontal">
        <Border Classes="telemetry-card" Width="240" MinHeight="154" Padding="17" Margin="0,0,12,12">
          <StackPanel Spacing="8"><TextBlock Text="DOWNLOAD" Classes="eyebrow"/><TextBlock Text="{Binding DownloadLabel}" FontSize="31" FontWeight="SemiBold"/><ProgressBar Value="{Binding Download}" Maximum="{Binding ScaleMaximum}" Height="10" IsVisible="{Binding HasSamples}"/><Grid ColumnDefinitions="*,Auto"><TextBlock Text="History peak" Classes="muted" FontSize="10"/><TextBlock Grid.Column="1" Text="{Binding PeakDownloadLabel}" Classes="muted" FontSize="10"/></Grid></StackPanel>
        </Border>
        <Border Classes="telemetry-card" Width="240" MinHeight="154" Padding="17" Margin="0,0,12,12">
          <StackPanel Spacing="8"><TextBlock Text="UPLOAD" Classes="eyebrow"/><TextBlock Text="{Binding UploadLabel}" FontSize="31" FontWeight="SemiBold"/><ProgressBar Value="{Binding Upload}" Maximum="{Binding ScaleMaximum}" Height="10" IsVisible="{Binding HasSamples}"/><Grid ColumnDefinitions="*,Auto"><TextBlock Text="History peak" Classes="muted" FontSize="10"/><TextBlock Grid.Column="1" Text="{Binding PeakUploadLabel}" Classes="muted" FontSize="10"/></Grid></StackPanel>
        </Border>
        <Border Classes="panel" Width="220" MinHeight="154" Margin="0,0,12,12">
          <StackPanel Spacing="8" VerticalAlignment="Center"><TextBlock Text="COMBINED RATE" Classes="eyebrow"/><TextBlock Text="{Binding CombinedLabel}" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Download + upload at the latest sample" Classes="muted" FontSize="11" TextWrapping="Wrap"/></StackPanel>
        </Border>
      </WrapPanel>

      <Border Classes="panel">
        <StackPanel Spacing="11">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <StackPanel Spacing="3"><TextBlock Text="THROUGHPUT HISTORY" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding SamplingNote}" Classes="muted" FontSize="11"/></StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding SampleCount, StringFormat={}{0} SAMPLES}" Classes="eyebrow" VerticalAlignment="Center"/>
          </Grid>
          <Grid Height="240" ClipToBounds="True" IsVisible="{Binding HasSamples}">
            <controls:TelemetryGraph Values="{Binding DownloadHistory}" Stroke="{DynamicResource ThemeAccentBrush}" Minimum="0" Maximum="{Binding ScaleMaximum}"/>
            <controls:TelemetryGraph Values="{Binding UploadHistory}" Stroke="#D86B24" Minimum="0" Maximum="{Binding ScaleMaximum}" ShowGrid="False"/>
          </Grid>
          <Border IsVisible="{Binding HasNoSamples}" Background="{DynamicResource ThemeSoftBrush}" CornerRadius="9" Padding="14"><TextBlock Text="Collecting the second interface sample to calculate throughput…" Classes="muted" FontSize="12" TextWrapping="Wrap"/></Border>
          <StackPanel Orientation="Horizontal" Spacing="14">
            <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="9" Height="9" CornerRadius="5" Background="{DynamicResource ThemeAccentBrush}"/><TextBlock Text="DOWNLOAD" Classes="muted" FontSize="10"/></StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="9" Height="9" CornerRadius="5" Background="#D86B24"/><TextBlock Text="UPLOAD" Classes="muted" FontSize="10"/></StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="telemetry-card" Padding="15">
        <StackPanel Spacing="6"><TextBlock Text="COUNTER SCOPE" Classes="eyebrow"/><TextBlock Text="Rates are aggregated across operational network interfaces. Loopback and tunnel interfaces are excluded by the sampler; adapter name, negotiated link speed, latency and packet loss are not collected here." Classes="muted" FontSize="12" TextWrapping="Wrap"/></StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
