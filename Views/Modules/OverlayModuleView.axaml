<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:ExteraMonitor.ViewModels.Modules" x:Class="ExteraMonitor.Views.Modules.OverlayModuleView" x:DataType="vm:OverlayModuleViewModel"><ScrollViewer><StackPanel Margin="42,34,42,42" Spacing="24"><StackPanel Spacing="6"><TextBlock Text="Overlay" FontSize="31" FontWeight="SemiBold"/><TextBlock Text="Configure a minimal telemetry overlay for an unobtrusive always-on-top view." Classes="muted" FontSize="14"/></StackPanel><Grid ColumnDefinitions="1.1*,*" ColumnSpacing="18"><Border Classes="panel"><StackPanel Spacing="20"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="DESKTOP OVERLAY" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Enable the compact monitoring layer." Classes="muted" FontSize="12" Margin="0,4,0,0"/></StackPanel><ToggleSwitch Grid.Column="1" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center"/></Grid><Border Height="1" Background="#A5C9CA"/><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Always on top"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding AlwaysOnTop}"/></Grid><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Show CPU usage"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowCpu}"/></Grid><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Show memory usage"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowMemory}"/></Grid><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Show network throughput"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowNetwork}"/></Grid></StackPanel></Border><Border Grid.Column="1" Background="#2C3333" CornerRadius="18" Padding="24" IsVisible="{Binding IsEnabled}"><StackPanel Spacing="16"><TextBlock Text="OVERLAY PREVIEW" Foreground="#A5C9CA" FontSize="10" FontWeight="Bold" LetterSpacing="2"/><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="SYSTEM PULSE" Foreground="#E7F6F2" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="LIVE • LOCAL" Foreground="#A5C9CA" FontSize="10" LetterSpacing="1"/></StackPanel><Border Grid.Column="1" Background="#395B64" CornerRadius="8" Padding="8,4"><TextBlock Text="ACTIVE" Foreground="#E7F6F2" FontSize="10"/></Border></Grid><Border Height="1" Background="#395B64"/><StackPanel IsVisible="{Binding ShowCpu}" Spacing="3"><TextBlock Text="CPU" Foreground="#A5C9CA" FontSize="10" LetterSpacing="1"/><TextBlock Text="{Binding Cpu, StringFormat={}{0:0.0}%}" Foreground="#E7F6F2" FontSize="27"/></StackPanel><StackPanel IsVisible="{Binding ShowMemory}" Spacing="3"><TextBlock Text="MEMORY" Foreground="#A5C9CA" FontSize="10" LetterSpacing="1"/><TextBlock Text="{Binding Memory, StringFormat={}{0:0.0}%}" Foreground="#E7F6F2" FontSize="27"/></StackPanel><StackPanel IsVisible="{Binding ShowNetwork}" Spacing="3"><TextBlock Text="DOWNLOAD" Foreground="#A5C9CA" FontSize="10" LetterSpacing="1"/><TextBlock Text="{Binding Download, StringFormat={}{0:0.0} Mbps}" Foreground="#E7F6F2" FontSize="27"/></StackPanel></StackPanel></Border></Grid><Border Classes="card"><StackPanel Spacing="8"><TextBlock Text="ABOUT THE OVERLAY" Classes="eyebrow"/><TextBlock Text="The preview mirrors the compact monitor layout. Its options are isolated in this module, ready to be connected to a dedicated transparent overlay window when you want a second desktop surface." Classes="muted" TextWrapping="Wrap"/></StackPanel></Border></StackPanel></ScrollViewer></UserControl>
