<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ExteraMonitor.ViewModels.Modules"
             x:Class="ExteraMonitor.Views.Modules.OverlayModuleView"
             x:CompileBindings="False">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24,22,24,28" Spacing="16">
      <StackPanel Spacing="4">
        <TextBlock Text="Overlay" FontSize="30" FontWeight="SemiBold"/>
        <TextBlock Text="A compact, independent desktop telemetry window." Classes="muted" FontSize="13" TextWrapping="Wrap"/>
      </StackPanel>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
        <Border Classes="panel">
          <StackPanel Spacing="16">
            <StackPanel Spacing="3"><TextBlock Text="OVERLAY CONTROLS" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Changes apply to the floating window immediately." Classes="muted" FontSize="11" TextWrapping="Wrap"/></StackPanel>
            <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="2"><TextBlock Text="Show desktop overlay" FontWeight="SemiBold"/><TextBlock Text="Open or hide the compact window" Classes="muted" FontSize="10"/></StackPanel><ToggleSwitch Grid.Column="1" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center"/></Grid>
            <Border Height="1" Background="{DynamicResource ThemeSoftBrush}"/>
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Keep above other windows" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding AlwaysOnTop}"/></Grid>
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="CPU utilization" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowCpu}"/></Grid>
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Memory utilization" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowMemory}"/></Grid>
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Network throughput" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowNetwork}"/></Grid>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="{DynamicResource ThemeChromeBrush}" BorderBrush="{DynamicResource ThemeAccentBrush}" BorderThickness="1" CornerRadius="17" Padding="18" Opacity="{Binding PreviewOpacity}">
          <StackPanel Spacing="13">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <StackPanel Spacing="3"><TextBlock Text="LIVE PREVIEW" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="10" FontWeight="Bold" LetterSpacing="1.5"/><TextBlock Text="EXTERA MONITOR" Foreground="{DynamicResource ThemeTextBrush}" FontSize="15" FontWeight="SemiBold"/></StackPanel>
              <Border Grid.Column="1" Background="{DynamicResource ThemeAccentBrush}" CornerRadius="7" Padding="8,5" VerticalAlignment="Center"><TextBlock Text="{Binding StatusLabel}" Foreground="{DynamicResource ThemeOnAccentBrush}" FontSize="9" FontWeight="Bold"/></Border>
            </Grid>
            <Border Height="1" Background="{DynamicResource ThemeAccentBrush}"/>
            <StackPanel IsVisible="{Binding ShowCpu}" Spacing="3"><TextBlock Text="CPU LOAD" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="9" LetterSpacing="1.2"/><TextBlock Text="{Binding Cpu, StringFormat={}{0:0.0}%}" Foreground="{DynamicResource ThemeTextBrush}" FontSize="25" FontWeight="SemiBold"/></StackPanel>
            <StackPanel IsVisible="{Binding ShowMemory}" Spacing="3"><TextBlock Text="MEMORY" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="9" LetterSpacing="1.2"/><TextBlock Text="{Binding MemoryLabel}" Foreground="{DynamicResource ThemeTextBrush}" FontSize="25" FontWeight="SemiBold"/></StackPanel>
            <StackPanel IsVisible="{Binding ShowNetwork}" Spacing="3"><TextBlock Text="NETWORK" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="9" LetterSpacing="1.2"/><TextBlock Text="{Binding NetworkText}" Foreground="{DynamicResource ThemeTextBrush}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
            <TextBlock Text="No metrics selected" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="12" IsVisible="{Binding HasNoVisibleMetrics}"/>
          </StackPanel>
        </Border>
      </Grid>

      <Border Classes="telemetry-card" Padding="14">
        <StackPanel Spacing="5"><TextBlock Text="WINDOW BEHAVIOR" Classes="eyebrow"/><TextBlock Text="The floating window can be dragged by its header and hidden with its close button. Its visibility and topmost state are controlled above; telemetry follows the same live snapshot as the main app." Classes="muted" FontSize="12" TextWrapping="Wrap"/></StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
