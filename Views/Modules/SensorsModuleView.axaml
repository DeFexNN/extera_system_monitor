<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:ExteraMonitor.ViewModels.Modules" x:Class="ExteraMonitor.Views.Modules.SensorsModuleView" x:DataType="vm:SensorsModuleViewModel"><ScrollViewer><StackPanel Margin="42,34,42,42" Spacing="24"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="6"><TextBlock Text="Sensors" FontSize="31" FontWeight="SemiBold"/><TextBlock Text="Hardware telemetry exposed by the local system." Classes="muted" FontSize="14"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Items.Count, StringFormat={}{0} READINGS}" Classes="eyebrow" VerticalAlignment="Center"/></Grid><Border Classes="card"><StackPanel Spacing="7"><TextBlock Text="SENSOR ACCESS" Classes="eyebrow"/><TextBlock Text="CPU temperature is read from the ExteraMonitorDriver kernel driver. Libre Hardware Monitor remains an optional fallback source. Missing readings are omitted rather than estimated." Classes="muted" TextWrapping="Wrap"/></StackPanel></Border><Border Classes="panel"><Grid RowDefinitions="Auto,*"><Grid ColumnDefinitions="1.2*,1.2*,*,Auto" Margin="0,0,0,12"><TextBlock Text="HARDWARE" Classes="eyebrow"/><TextBlock Grid.Column="1" Text="SENSOR" Classes="eyebrow"/><TextBlock Grid.Column="2" Text="TYPE" Classes="eyebrow"/><TextBlock Grid.Column="3" Text="VALUE" Classes="eyebrow"/></Grid><ItemsControl Grid.Row="1" ItemsSource="{Binding Items}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#A5C9CA" BorderThickness="0,1,0,0" Padding="0,12"><Grid ColumnDefinitions="1.2*,1.2*,*,Auto"><TextBlock Text="{Binding HardwareName}"/><TextBlock Grid.Column="1" Text="{Binding Name}" Classes="muted"/><TextBlock Grid.Column="2" Text="{Binding Type}"/><TextBlock Grid.Column="3" Text="{Binding Value, StringFormat={}{0:0.##}}" FontWeight="SemiBold"/><TextBlock Grid.Column="3" Text="{Binding Unit}" Margin="54,0,0,0" VerticalAlignment="Center" Classes="muted"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></Border></StackPanel></ScrollViewer></UserControl>
