<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:ExteraMonitor.ViewModels" x:Class="ExteraMonitor.Views.MainWindow" x:DataType="vm:MainViewModel" Title="ExteraMonitor // System Monitor" Width="1360" Height="820" MinWidth="860" MinHeight="600" Background="Transparent" WindowDecorations="None" TransparencyLevelHint="Transparent">
  <Design.DataContext><vm:MainViewModel /></Design.DataContext>
  <Border Background="{DynamicResource ThemeChromeBrush}" BorderBrush="{DynamicResource ThemeAccentBrush}" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
    <Grid RowDefinitions="42,*,30" ColumnDefinitions="260,*">
      <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource ThemeChromeBrush}" Padding="18,0,0,0">
        <Grid ColumnDefinitions="*,Auto">
          <Border Grid.Column="0" Background="Transparent" PointerPressed="TitleBar_PointerPressed"><StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"><Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource ThemeAccentBrush}" VerticalAlignment="Center"/><TextBlock Text="EXTERA MONITOR" Foreground="{DynamicResource ThemeWindowBrush}" FontSize="12" FontWeight="Bold" LetterSpacing="2" VerticalAlignment="Center"/><TextBlock Text="/ SYSTEM MONITOR" Foreground="{DynamicResource ThemeSoftBrush}" FontSize="11" LetterSpacing="1" VerticalAlignment="Center"/></StackPanel></Border>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0"><Button Classes="window-control" Click="Minimize_Click" ToolTip.Tip="Minimize"><Path Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 3,8 L 13,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeLineCap="Round"/></Button><Button Classes="window-control" Click="Maximize_Click" ToolTip.Tip="Maximize or restore"><Path Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 3,3 L 13,3 L 13,13 L 3,13 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"/></Button><Button Classes="window-control close" Click="Close_Click" ToolTip.Tip="Close"><Path Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 3,3 L 13,13 M 13,3 L 3,13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeLineCap="Round"/></Button></StackPanel>
        </Grid>
      </Border>
      <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource ThemeChromeBrush}" Padding="24,28"><Grid RowDefinitions="Auto,Auto,*,Auto"><StackPanel Spacing="4"><TextBlock Text="EXTERA MONITOR" Foreground="{DynamicResource ThemeWindowBrush}" FontSize="18" FontWeight="Bold" LetterSpacing="1" TextWrapping="NoWrap"/><TextBlock Text="SYSTEM MONITOR" Foreground="{DynamicResource ThemeSoftBrush}" FontSize="10" LetterSpacing="2"/></StackPanel><Border Grid.Row="1" Height="1" Background="{DynamicResource ThemeAccentBrush}" Margin="0,28,0,22"/><ItemsControl Grid.Row="2" ItemsSource="{Binding Navigation}"><ItemsControl.ItemTemplate><DataTemplate><Button Classes="nav-item" Classes.selected="{Binding IsSelected}" Command="{Binding $parent[Window].DataContext.SelectSectionCommand}" CommandParameter="{Binding Label}"><StackPanel Orientation="Horizontal" Spacing="14"><TextBlock Text="{Binding Icon}" FontSize="20" Width="22"/><TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontSize="14"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><StackPanel Grid.Row="3" Spacing="10"><Border Height="1" Background="{DynamicResource ThemeAccentBrush}"/><TextBlock Text="WORKSTATION" Classes="eyebrow" Foreground="{DynamicResource ThemeSoftBrush}"/><TextBlock Text="{Binding WorkstationName}" Foreground="{DynamicResource ThemeWindowBrush}" FontSize="12"/><TextBlock Text="v0.2.0 • MODULAR BUILD" Foreground="{DynamicResource ThemeSoftBrush}" FontSize="10"/></StackPanel></Grid></Border>
      <Border Grid.Row="1" Grid.Column="1" Margin="10" Background="{DynamicResource ThemeWindowBrush}" BorderBrush="{DynamicResource ThemeChromeBrush}" BorderThickness="2" CornerRadius="22" ClipToBounds="True">
        <ContentControl Content="{Binding ActiveModule}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
      </Border>
      <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource ThemeChromeBrush}" BorderBrush="{DynamicResource ThemeAccentBrush}" BorderThickness="0,1,0,0" Padding="13,0">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="16">
          <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
            <Border Width="7" Height="7" CornerRadius="4" Background="{DynamicResource ThemeAccentBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding StatusLabel}" Classes="eyebrow" Foreground="{DynamicResource ThemeWindowBrush}" FontSize="9" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding LastUpdated}" Classes="muted" FontSize="9" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="2" Text="LOCAL TELEMETRY · REQUESTED INTERVAL 2 SEC" Classes="muted" FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
          <Button Grid.Column="3" Classes="module-action" Content="{Binding LiveActionLabel}" Command="{Binding ToggleLiveCommand}" Padding="12,4" VerticalAlignment="Center" ToolTip.Tip="Pause or resume telemetry sampling"/>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
