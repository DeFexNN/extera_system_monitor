<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ExteraMonitor.ViewModels.Modules"
        x:Class="ExteraMonitor.Views.OverlayWindow"
        x:DataType="vm:OverlayModuleViewModel"
        Title="Extera Monitor Overlay"
        Width="300" Height="300" MinWidth="260" MinHeight="170" MaxWidth="420"
        ShowInTaskbar="False" WindowStartupLocation="CenterScreen" WindowDecorations="None"
        Background="Transparent" TransparencyLevelHint="Transparent" CanResize="False"
        Topmost="{Binding AlwaysOnTop}">
  <Border Background="{DynamicResource ThemeChromeBrush}" BorderBrush="{DynamicResource ThemeAccentBrush}" BorderThickness="1" CornerRadius="16" Padding="15" ClipToBounds="True">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <StackPanel Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="EXTERA MONITOR" Foreground="{DynamicResource ThemeWindowBrush}" FontSize="12" FontWeight="Bold" LetterSpacing="1.3"/>
          <TextBlock Text="LIVE SYSTEM TELEMETRY" Foreground="{DynamicResource ThemeSoftBrush}" FontSize="9" LetterSpacing="1" PointerPressed="Header_PointerPressed"/>
        </StackPanel>
        <Button Grid.Column="1" Content="×" Classes="toolbar-action" Foreground="{DynamicResource ThemeSoftBrush}" FontSize="16" Click="Hide_Click" ToolTip.Tip="Hide overlay"/>
      </Grid>
      <Border Grid.Row="1" Height="1" Background="{DynamicResource ThemeAccentBrush}"/>
      <StackPanel Grid.Row="2" Spacing="9">
        <Grid IsVisible="{Binding ShowCpu}" ColumnDefinitions="*,Auto"><TextBlock Text="CPU" Foreground="{DynamicResource ThemeSoftBrush}" FontSize="10" LetterSpacing="1"/><TextBlock Grid.Column="1" Text="{Binding Cpu, StringFormat={}{0:0.0}%}" Foreground="{DynamicResource ThemeWindowBrush}" FontSize="18" FontWeight="SemiBold"/></Grid>
        <Grid IsVisible="{Binding ShowMemory}" ColumnDefinitions="*,Auto"><TextBlock Text="MEMORY" Foreground="{DynamicResource ThemeSoftBrush}" FontSize="10" LetterSpacing="1"/><TextBlock Grid.Column="1" Text="{Binding MemoryLabel}" Foreground="{DynamicResource ThemeWindowBrush}" FontSize="18" FontWeight="SemiBold"/></Grid>
        <Grid IsVisible="{Binding ShowNetwork}" ColumnDefinitions="*,Auto"><TextBlock Text="DOWNLOAD" Foreground="{DynamicResource ThemeSoftBrush}" FontSize="10" LetterSpacing="1"/><TextBlock Grid.Column="1" Text="{Binding Download, StringFormat={}{0:0.0} Mbps}" Foreground="{DynamicResource ThemeWindowBrush}" FontSize="13" FontWeight="SemiBold"/></Grid>
        <Grid IsVisible="{Binding ShowNetwork}" ColumnDefinitions="*,Auto"><TextBlock Text="UPLOAD" Foreground="{DynamicResource ThemeSoftBrush}" FontSize="10" LetterSpacing="1"/><TextBlock Grid.Column="1" Text="{Binding Upload, StringFormat={}{0:0.0} Mbps}" Foreground="{DynamicResource ThemeWindowBrush}" FontSize="13" FontWeight="SemiBold"/></Grid>
        <TextBlock Text="No metrics selected" Foreground="{DynamicResource ThemeSoftBrush}" FontSize="11" IsVisible="{Binding HasNoVisibleMetrics}"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
