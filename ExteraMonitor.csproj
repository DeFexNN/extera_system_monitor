<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ExteraMonitor</AssemblyName>
    <RootNamespace>ExteraMonitor</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\extera-monitor.ico</ApplicationIcon>
    <Version>0.2.2</Version>
    <FileVersion>0.2.2.0</FileVersion>
    <AssemblyVersion>0.2.2.0</AssemblyVersion>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj-verify/**;build-verify/**;TempProbe/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
    <Content Include="Driver\kvc.exe" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" Condition="Exists('Driver\kvc.exe')" />
    <Content Include="Driver\kvc.dat" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" Condition="Exists('Driver\kvc.dat')" />
    <Content Include="Driver\ExteraMonitorDriver.sys" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" Condition="Exists('Driver\ExteraMonitorDriver.sys')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>
</Project>
